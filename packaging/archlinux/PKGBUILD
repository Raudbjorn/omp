# Maintainer: Sveinbjörn Geirsson <claude@sveinbjorn.dev>
#
# Build-and-install PKGBUILD for omp — Raudbjorn's fork of oh-my-pi.
#
# Default: fetches the pinned release tag from github.com/Raudbjorn/omp
# via git+https. Someone running `makepkg -si` from a checkout of this
# PKGBUILD alone will get a reproducible build of that release.
#
# To build from a local worktree instead (dev mode), point OMP_REPO at
# a checkout; that short-circuits the git+https fetch and rsyncs your
# worktree — uncommitted changes included — into $srcdir:
#
#   OMP_REPO=/home/you/dev/omp makepkg -si
#
# Build strategy (mirrors the can1357/oh-my-pi AUR PKGBUILD):
#   1. Build native addons directly via cargo (baseline + modern variants)
#      and install them as .node files alongside the compiled binary.
#   2. Compile omp with `bun build --compile` WITHOUT embedding the native
#      addon and WITHOUT setting PI_COMPILED=true. At runtime the loader
#      resolves `.node` from `path.dirname(process.execPath)`. On Linux,
#      process.execPath is derived from /proc/self/exe and resolves
#      symlinks, so the /usr/bin/omp -> /usr/lib/omp/omp entry point
#      yields execDir=/usr/lib/omp — where the addons live, FHS-compliantly.
#      No extraction-to-$HOME dance is needed.
#
# This avoids the workspace-wide `bun run build` + embed:native + runtime
# extraction path, which was observed to leave the event loop unreachable
# on exit (process hangs after main returns).

pkgname=omp
_release_tag='v14.1.4-acp.3'
pkgver=14.1.4.acp.3
pkgrel=1
pkgdesc='Coding agent CLI with read, bash, edit, write tools and session management (Raudbjorn fork of oh-my-pi)'
# x86_64-only: the packaged pi-natives addons are built twice (baseline
# x86-64-v2 and modern x86-64-v3) to cover Steam-hardware-survey-class CPU
# contracts. Enabling aarch64 would require a separate cargo target, a
# single-variant loader path in packages/natives/native/index.js, and
# testing on ARM hardware the maintainer does not have. Contributors with
# aarch64 hardware are welcome to extend this; drop a CARCH branch into
# build() + package() and add aarch64 here.
arch=('x86_64')
url='https://github.com/Raudbjorn/omp'
license=('MIT')
# The compiled binary bundles the bun runtime, so runtime deps are minimal.
# icu + zlib match upstream's depends (surfaced by transitive Rust crates).
depends=('gcc-libs' 'glibc' 'icu' 'zlib')
# bun compiles the standalone binary; rustup provides the pinned nightly
# declared in rust-toolchain.toml; zig pins CPU contracts for zlob's
# host-side build.rs on both variants. rsync + jq are only needed for the
# local-worktree dev path; keep them as makedeps so OMP_REPO works out of
# the box.
makedepends=('bun>=1.3.7' 'rustup' 'zig' 'git' 'rsync' 'jq')
# bun's --compile output is already a stripped, standalone binary; re-stripping
# or trying to extract debug symbols from it breaks makepkg.
options=('!strip' '!debug' '!lto')
provides=('omp-coding-agent')

# Optional local-dev override: if OMP_REPO is set and exists, we skip the
# git checkout entirely and rsync the worktree in during prepare().
# Declared before source= so we can conditionally skip the git clone (the
# referenced tag doesn't need to exist yet during dev).
_default_repo=''
_repo="${OMP_REPO:-$_default_repo}"

# Production source: shallow-clone the tag from GitHub. In dev mode
# (OMP_REPO set) we elide the source array entirely so makepkg doesn't
# try to resolve a tag that may not exist yet.
if [[ -n "${_repo}" && -d "${_repo}/.git" ]]; then
	source=()
	sha256sums=()
else
	source=("${pkgname}-${pkgver}::git+${url}.git#tag=${_release_tag}")
	sha256sums=('SKIP')
fi

pkgver() {
	# When built from the git+https source, the tag is authoritative: we
	# keep the static pkgver above. When OMP_REPO is set, derive a dev
	# pkgver from the worktree so every rebuild is strictly increasing.
	if [[ -n "${_repo}" && -d "${_repo}/.git" ]]; then
		cd "${_repo}"
		local base rev sha
		base="$(jq -r '.version' packages/coding-agent/package.json 2>/dev/null || echo '14.1.4')"
		rev="$(git rev-list --count HEAD 2>/dev/null || echo 0)"
		sha="$(git rev-parse --short=8 HEAD 2>/dev/null || echo 00000000)"
		printf '%s.r%s.%s' "${base}" "${rev}" "${sha}"
	else
		printf '%s' "${pkgver}"
	fi
}

prepare() {
	if [[ -n "${_repo}" && -d "${_repo}/.git" ]]; then
		msg2 "Using local worktree: %s" "${_repo}"
		rm -rf "${srcdir}/${pkgname}-${pkgver}" "${srcdir}/${pkgname}"
		mkdir -p "${srcdir}/${pkgname}"
		rsync -a --delete \
			--exclude='/.git/' \
			--exclude='/node_modules/' \
			--exclude='/target/' \
			--exclude='/dist/' \
			--exclude='/dist-release/' \
			--exclude='/packaging/archlinux/src/' \
			--exclude='/packaging/archlinux/pkg/' \
			--exclude='/packaging/archlinux/omp-*/' \
			--exclude='/packaging/archlinux/*.pkg.tar.*' \
			--exclude='**/node_modules/' \
			--exclude='**/dist/' \
			--exclude='**/target/' \
			--exclude='**/.turbo/' \
			--exclude='**/tsconfig.tsbuildinfo' \
			--exclude='**/*.tsbuildinfo' \
			"${_repo}/" "${srcdir}/${pkgname}/"
	else
		# Production path: the makepkg-cloned tree lives at
		# $srcdir/${pkgname}-${pkgver} (because of the named source=()
		# entry). Symlink it as $srcdir/${pkgname} so build() can be
		# path-agnostic.
		ln -sfn "${pkgname}-${pkgver}" "${srcdir}/${pkgname}"
	fi

	cd "${srcdir}/${pkgname}"

	# Install the pinned Rust nightly (honours rust-toolchain.toml) without
	# touching the user's default toolchain.
	if [[ -f rust-toolchain.toml ]]; then
		local channel
		channel="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
		if [[ -n "${channel}" ]]; then
			rustup toolchain install "${channel}" --profile minimal --no-self-update
			rustup component add --toolchain "${channel}" rustfmt clippy
		fi
	fi

	# Isolate bun's global install state to the build dir so the user's
	# ~/.bun is untouched and the build is reproducible. Prefer the
	# pacman-installed /usr/bin/bun (tracked as a makedep) over any older
	# user-local bun on $PATH — the build uses Bun.Archive.write (≥1.3.7).
	export BUN_INSTALL="${srcdir}/.bun"
	export PATH="/usr/bin:${BUN_INSTALL}/bin:${PATH}"

	local bun_ver
	bun_ver="$(/usr/bin/bun --version 2>/dev/null || true)"
	msg2 "Using bun: /usr/bin/bun (%s)" "${bun_ver:-unknown}"
}

build() {
	cd "${srcdir}/${pkgname}"

	export BUN_INSTALL="${srcdir}/.bun"
	export PATH="/usr/bin:${BUN_INSTALL}/bin:${PATH}"
	# Keep bun quiet; telemetry already disabled in bunfig.toml.
	export DO_NOT_TRACK=1
	export CI=1

	# Resolve pinned toolchain channel from rust-toolchain.toml so cargo
	# uses the same compiler as the rest of the workspace.
	local _toolchain
	_toolchain="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
	if [[ -z "${_toolchain}" ]]; then
		error "Could not parse rust-toolchain.toml channel"
		return 1
	fi

	local _rust_target='x86_64-unknown-linux-gnu'

	# Install workspace deps (frozen lockfile for reproducibility). The
	# top-level install is required even though we're bypassing the workspace
	# build, because coding-agent's source imports @oh-my-pi/* workspace
	# packages that bun resolves via node_modules.
	bun install --frozen-lockfile

	# Step 1: build the native addons directly via cargo — two variants,
	# one per CPU contract. This is the upstream (can1357/oh-my-pi) approach
	# and avoids napi-rs/build-native.ts orchestration, which wires up the
	# embedded-addon extraction path that we don't want in the packaged
	# build. The .so produced by `cargo build --release -p pi-natives` is
	# identical to what napi-rs renames to .node.
	local _variant _cpu _target_dir
	for _variant in baseline modern; do
		if [[ "${_variant}" = 'modern' ]]; then
			_cpu='x86-64-v3'
		else
			_cpu='x86-64-v2'
		fi
		_target_dir="${srcdir}/target-${_variant}"
		msg2 "Building pi-natives (${_variant}, target-cpu=${_cpu})"
		CARGO_TARGET_DIR="${_target_dir}" RUSTFLAGS="-C target-cpu=${_cpu}" \
			rustup run "${_toolchain}" cargo build \
				--release \
				--target "${_rust_target}" \
				-p pi-natives
		install -Dm755 \
			"${_target_dir}/${_rust_target}/release/libpi_natives.so" \
			"packages/natives/native/pi_natives.linux-x64-${_variant}.node"
	done

	# Step 2: generate the stats client bundle that coding-agent imports.
	# This is the only workspace-prep step we keep from the upstream
	# `bun run build` — others would pull in things we don't need.
	bun --cwd=packages/stats scripts/generate-client-bundle.ts --generate

	# Step 3: compile the standalone binary WITHOUT embed:native and WITHOUT
	# --define PI_COMPILED=true. The runtime loader in
	# packages/natives/native/index.js falls back to
	# path.dirname(process.execPath) — i.e. /usr/bin/ — where we'll install
	# the .node files in package(). No extraction path is taken.
	cd packages/coding-agent
	bun build \
		--compile \
		--external mupdf \
		--root ../.. \
		./src/cli.ts \
		--outfile dist/omp
	cd "${srcdir}/${pkgname}"

	# Step 4: reset the stats client bundle stub so the worktree isn't
	# permanently dirty after a dev-mode build.
	bun --cwd=packages/stats scripts/generate-client-bundle.ts --reset
}

check() {
	cd "${srcdir}/${pkgname}/packages/coding-agent/dist"

	# Mirror the install-time layout so the native loader finds its addons
	# during check(): the runtime loader uses path.dirname(process.execPath),
	# which here points at dist/ — but the cargo-built .node files live two
	# directories up at packages/natives/native/. Without these, the loader
	# would silently fall back to an un-addon'd code path and the
	# hang-on-exit regression this check is supposed to catch wouldn't
	# trigger.
	local _variant
	for _variant in baseline modern; do
		local _addon="${srcdir}/${pkgname}/packages/natives/native/pi_natives.linux-x64-${_variant}.node"
		if [[ -f "${_addon}" ]]; then
			install -m755 "${_addon}" "./pi_natives.linux-x64-${_variant}.node"
		fi
	done

	# Regression guard: previously, the workspace-wide build + embed:native
	# + runtime-extraction path produced a binary that hung on exit after
	# --version. Run with a timeout so a regression here fails the build
	# instead of hanging makepkg — and run every invocation under the same
	# timeout, so an unguarded sanity call can't wedge makepkg on its own.
	msg2 "Verifying --version exits cleanly..."
	if ! timeout --signal=KILL 10 ./omp --version >/dev/null; then
		error "omp --version hung (>10s) — the hang-on-exit regression is back"
		return 1
	fi
	msg2 "omp --version returned and exited cleanly."
}

package() {
	cd "${srcdir}/${pkgname}"

	# FHS-compliant layout: keep the binary and its N-API addons together
	# in /usr/lib/omp/ (where shared objects belong) and expose the entry
	# point via a single /usr/bin/omp symlink. On Linux, process.execPath
	# is derived from /proc/self/exe and resolves symlinks, so the
	# runtime loader's path.dirname(process.execPath) lookup still lands
	# in /usr/lib/omp/ — no per-addon symlink dance required.
	install -Dm755 packages/coding-agent/dist/omp "${pkgdir}/usr/lib/${pkgname}/omp"

	local _variant
	for _variant in baseline modern; do
		local _addon="packages/natives/native/pi_natives.linux-x64-${_variant}.node"
		if [[ -f "${_addon}" ]]; then
			install -Dm755 "${_addon}" \
				"${pkgdir}/usr/lib/${pkgname}/pi_natives.linux-x64-${_variant}.node"
		fi
	done

	install -dm755 "${pkgdir}/usr/bin"
	ln -s "../lib/${pkgname}/omp" "${pkgdir}/usr/bin/omp"

	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

	# Stash a copy of AGENTS.md and STAGES.md alongside the README — they're
	# the project's primary developer documentation.
	local doc
	for doc in AGENTS.md STAGES.md; do
		if [[ -f "${doc}" ]]; then
			install -Dm644 "${doc}" "${pkgdir}/usr/share/doc/${pkgname}/${doc}"
		fi
	done
}
